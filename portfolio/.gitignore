# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-libs/
env/

# ---- 数据库（含访客留言与 IP，属于运行时数据，不要入库）----
data/*.db
data/*.db-wal
data/*.db-shm
*.sqlite3

# ---- 构建产物（不追踪，用脚本重建）----
# dist/portfolio-standalone.html  -> python tests/build_standalone.py
# ../docs/index.html              -> python tests/build_pages.py
# 二者内容相同，保留 dist/ 只是方便本地双击预览。
# 之所以不入库：它们各有 130 KB，且每次改内容都会产生新版本，
# 会让仓库历史快速膨胀。克隆后执行上面的命令即可生成。
dist/
tests/test_report.json

# ---- 素材原图 ----
# setup_avatar.py 会读取项目根目录的 photo.png 生成头像。
# 处理完请自行删除原图，或放到仓库外——网站只使用压缩后的
# frontend/static/assets/avatar.jpg，原图（可达数 MB）无需入库。
photo.png
photo.jpg
photo.jpeg

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时文件 ----
_tmp/
*.log
*.bak

# ---- 诊断脚本 ----
# 推送排查用的一次性脚本，不属于网站内容
diag-push.ps1
push-diagnostic.txt
